{
  "expo": {
    "name": "Class on Time",
    "slug": "class-on-time",
    "scheme": "classontime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff7ed"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naomi.classontime",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Class on Time uses your location to figure out how long it'll take you to walk to your next class.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Class on Time needs background location so it can wake you up to leave for class on time, even if the app is closed.",
        "NSLocationAlwaysUsageDescription": "Class on Time needs background location to detect when you arrive at class.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.naomi.classontime",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff7ed"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Class on Time uses your location to wake you up at the right moment to walk to class."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#fb923c"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Class on Time uses the mic so you can confirm each commitment out loud.",
          "speechRecognitionPermission": "Transcribes your morning roll-call on-device — nothing leaves your phone for transcription."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsDownloadToken": "pk.eyJ1IjoibmFvbWktaXZpZSIsImEiOiJjbW96MXpsdmIwZWw4MnJvcnJ2aW43cG50In0.h95iR6FYAi_5GVBl33Z9SA"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7d723e26-3340-4d0c-b9f6-36f4da0f23fe"
      }
    },
    "owner": "thecoder-7"
  }
}
